# Copy to .env and fill in. Never commit .env. Share the key and certificate with testers privately, not by chat or email threads.
OPENAI_API_KEY=
OPENAI_BASE_URL=            # the project's OpenAI-compatible gateway, for example https://<host>:<port>/v1
OPENAI_CA_BUNDLE=           # path to the gateway's CA certificate (.crt); TLS verification stays ON
# OPENAI_VERIFY_TLS=false   # only if you accept sending the key over an unverified connection
# Shared embedding endpoint (required by the institution). Use EMBED_BACKEND=local only as a development fallback.
EMBED_BACKEND=endpoint
EMBED_BASE_URL=             # for example https://<host>:<port>/v1
EMBED_MODEL_ENDPOINT=bge-small-en-v1.5
EMBED_CA_BUNDLE=            # path to the endpoint's CA certificate (.crt), kept out of git
EMBED_API_KEY=              # the shared embedding key from your coordinator
